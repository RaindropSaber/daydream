# SQLite is created automatically; no database service or DATABASE_URL is needed.
PORT=3000
# DATA_DIR=/absolute/path/to/workspace/data
# SQLITE_PATH=/absolute/path/to/workspace/data/frameflow.sqlite3
# FFMPEG_BIN=/absolute/path/to/ffmpeg

# Optional; model management can also save these encrypted in SQLite.
ARK_API_KEY=
# Text and assistant roles can be configured separately in model management.
# These variables supply defaults when no role-specific settings are saved.
ARK_TEXT_MODEL=deepseek-v4-1-flash-261017
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_AUDIO_MODEL=doubao-seed-2-1-lite-260915
DASHSCOPE_API_KEY=
WAN_REGION=beijing

# Optional text provider fallback when Ark is not configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
